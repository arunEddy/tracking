
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- 1. jQuery FIRST -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2. Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- 3. SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between mb-3">
        <h4 class="fw-bold">📤 Stock Out</h4>
        <button class="btn btn-primary" id="btnAdd">+ Stock Out</button>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Office</th>
                        <th>Date</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Serialized</th>
                        <th>AWB</th>
                        <th>Start No</th>
                        <th>End No</th>
                        <th>Balance</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="tblData"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="stockOutModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 id="modalTitle">Stock Out</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="soid">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label>Office Name <span style="color:red"> *</span></label>
                        <input id="officeName" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label>Out Date <span style="color:red"> *</span></label>
                        <input type="date" id="outDate" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label>Item Name<span style="color:red"> *</span></label>
                        <input id="itemName" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label>Quantity <span style="color:red"> *</span></label>
                        <input id="qty" type="number" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>
                            <input type="checkbox" id="serialized"> Serialized
                        </label>
                    </div>

                    <div class="col-md-3">
                        <label>
                            <input type="checkbox" id="awb"> AWB
                        </label>
                    </div>

                    <div class="col-md-4">
                        <label>Start No</label>
                        <input id="startNo" class="form-control" type="number">
                    </div>

                    <div class="col-md-4">
                        <label>End No</label>
                        <input id="endNo" class="form-control" type="number">
                    </div>

                    <div class="col-md-4">
                        <label>Balance Qty</label>
                        <input id="balQty" class="form-control" type="number">
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSave">💾 Save</button>
            </div>

        </div>
    </div>
</div>

<div id="loader" style="display:none">Loading...</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/StockOut.js" asp-append-version="true"></script>