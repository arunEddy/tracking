
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. jQuery FIRST -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2. Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- 3. SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h4 class="fw-bold">Stock Issue</h4>
        <button class="btn btn-primary" id="btnAdd">+ Add Stock Issue</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Office</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Serialized</th>
                    <th>AWB</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Balance</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="tblData"></tbody>
        </table>
    </div>

</div>
<div class="modal fade" id="stockIssueModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 id="modalTitle">Stock Issue</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="siId">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label>Office Name  <span style="color:red"> *</span></label>
                        <input type="text" id="officeName" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Issue Date  <span style="color:red"> *</span></label>
                        <input type="date" id="issueDate" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Customer Name</label>
                        <input type="text" id="customerName" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Item Name  <span style="color:red"> *</span></label>
                        <input type="text" id="itemName" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Voucher No</label>
                        <input type="number" id="VoucherNo" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label>Quantity<span style="color:red"> *</span></label>
                        <input type="number" id="qty" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Price</label>
                        <input type="number" id="price" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Start No</label>
                        <input type="number" id="startNo" class="form-control" >
                    </div>
                    <div class="col-md-4">
                        <label>End No</label>
                        <input type="number" id="endNo" class="form-control" >
                    </div>
                    <div class="col-md-4">
                        <label>Balance</label>
                        <input type="number" id="balQty" class="form-control" >
                    </div>
                    <div class="col-md-4">
                        <label>Item Price</label>
                        <input type="number" id="itemPrice" class="form-control" >
                    </div>
                    <div class="col-md-2 mt-4">
                        <input type="checkbox" id="serialized"> Serialized
                    </div>
                    <div class="col-md-2 mt-4">
                        <input type="checkbox" id="awb"> AWB
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSave">💾 Save</button>
               
            </div>

        </div>
    </div>
</div>

<div id="loader" style="display:none">Loading...</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/StockIssue.js" asp-append-version="true"></script>