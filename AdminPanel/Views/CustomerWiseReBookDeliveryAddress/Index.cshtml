
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold">📦 Customer Rebook Delivery Address</h4>
        <button class="btn btn-primary" id="btnAdd">+ Add New</button>
    </div>

    <!-- SEARCH -->
    <div class="card p-3 shadow-sm mb-3">
        <div class="row g-2">
            <div class="col-md-10">
                <input type="text" id="search" class="form-control" placeholder="Search by Shipper Name">
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100" id="btnSearch">Search</button>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Shipper</th>
                        <th>Consignee</th>
                        <th>Address</th>
                        <th>Pincode</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="tblData"></tbody>
            </table>
        </div>
    </div>

</div>
<div class="modal fade" id="mainModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 id="modalTitle">Add Record</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="id">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Shipper Name <span style="color:red"> *</span></label>
                        <input id="shipperName" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">ReBook Consignee Name <span style="color:red"> *</span></label>
                        <input id="reBookConsigneeName" class="form-control">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Delivery Address<span style="color:red"> *</span></label>
                        <textarea id="deliveryAddress" class="form-control"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Pincode<span style="color:red"> *</span></label>
                        <input id="pincode" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">City <span style="color:red"> *</span></label>
                        <input id="city" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">State <span style="color:red"> *</span></label>
                        <input id="state" class="form-control">
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSave">💾 Save</button>
            </div>

        </div>
    </div>
</div>
<script src="~/js/customerwiserebookdeliveryaddress.js" asp-append-version="true"></script>
