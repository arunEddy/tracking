
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

    body {
        font-family: Verdana;
        font-size: 12px;
        background: #f4f4f4;
    }

    .legacy-box {
        border: 1px solid #8d8d8d;
        background: #efefef;
    }

    .legacy-header {
        background: #b71919;
        color: white;
        font-weight: bold;
        padding: 4px 10px;
        font-size: 13px;
    }

    .legacy-title {
        text-align: center;
        font-weight: bold;
        font-size: 22px;
    }

    .legacy-label {
        font-weight: bold;
        margin-bottom: 2px;
    }

    .legacy-input,
    .legacy-select {
        height: 24px;
        border: 1px solid #1b75bc;
        font-size: 12px;
        padding: 2px 5px;
    }

    .table-sm td,
    .table-sm th {
        padding: 4px;
        vertical-align: middle;
    }

    .required {
        color: red;
        font-weight: bold;
    }

    .btn-legacy {
        padding: 2px 12px;
        font-size: 12px;
        border-radius: 0;
    }

    .modal-xl {
        max-width: 95%;
    }

    #loader {
        position: fixed;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background: rgba(255,255,255,.7);
        z-index: 99999;
        display: none;
    }

        #loader div {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
        }

</style>

<div id="loader">
    <div class="spinner-border text-danger"></div>
</div>

<div class="container-fluid mt-2">

    <div class="d-flex justify-content-between align-items-center mb-2">

        <h5 class="fw-bold">DRS ENTRY</h5>

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-circle"></i> Add New
        </button>

    </div>

    <table class="table table-bordered table-hover table-sm bg-white">

        <thead class="table-danger">

            <tr>
                <th>#</th>
                <th>DRS No</th>
                <th>Delivery Boy</th>
                <th>Mobile</th>
                <th>Office</th>
                <th class="text-center">Action</th>
            </tr>

        </thead>

        <tbody id="tblData"></tbody>

    </table>

</div>

<div class="modal fade" id="drsModal" data-bs-backdrop="static">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="legacy-header d-flex justify-content-between align-items-center">

                <span>FIELDS WITH <span class="required">*</span> MARK ARE MANDATORY.</span>

                <span class="legacy-title">DRS ENTRY - NEW</span>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body p-2">

                <input type="hidden" id="drsid" />

                <div class="legacy-box p-2">

                    <div class="row">

                        <div class="col-md-4">

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    DRS Made For
                                </div>

                                <div class="col-8">
                                    <select id="DRSMadeFor" class="form-select form-select-sm legacy-select">
                                        <option selected="selected" value="DELIVERY BOY">DELIVERY BOY</option>
                                        <option value="VEHICLE">VEHICLE</option>
                                        <option value="VEHICLE MARKET">VEHICLE MARKET</option>
                                    </select>
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    Delivery Office
                                </div>

                                <div class="col-8">
                                    <input id="DeliveryOffice" class="form-control form-control-sm legacy-input" value="HO - HEAD OFFICE" />
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    Connection Number
                                </div>

                                <div class="col-8">
                                    <input id="ConnectionNumber" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    Delivery Boy
                                </div>

                                <div class="col-8">
                                    <input id="DeliveryBoy" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    Vehicle Number
                                </div>

                                <div class="col-8">
                                    <input type="datetime-local" id="VehicleNumber" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    Delivery Date
                                </div>

                                <div class="col-8">
                                    <input type="date" id="DeliveryDate" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-4 legacy-label">
                                    DRS No.
                                </div>

                                <div class="col-8">
                                    <input id="DRSNo" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="row mb-1">

                                <div class="col-5 legacy-label">
                                    Allow Mobile Application
                                </div>

                                <div class="col-1">
                                    <input type="checkbox" id="AllowMobileApplication" class="form-check-input mt-1" />
                                </div>

                                <div class="col-2 legacy-label">
                                    Mobile No
                                </div>

                                <div class="col-4">
                                    <input type="number" id="MobileNo" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                            <div class="row mb-1">

                                <div class="col-5 legacy-label">
                                    Sim No
                                </div>

                                <div class="col-7">
                                    <input id="SimNo" class="form-control form-control-sm legacy-input" />
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="legacy-box mt-2">

                    <div class="legacy-header">

                        <div class="row">

                            <div class="col-md-2">
                                Awb No <span class="required">*</span>
                            </div>

                            <div class="col-md-4">
                                Consignee Name
                            </div>

                            <div class="col-md-2">
                                Save
                            </div>

                        </div>

                    </div>

                    <div class="p-2">

                        <div class="row">

                            <div class="col-md-2">
                                <input id="AwbNo" class="form-control form-control-sm legacy-input" />
                            </div>

                            <div class="col-md-4">
                                <input id="ConsigneeName" class="form-control form-control-sm legacy-input" />
                            </div>

                            <div class="col-md-2">
                                <button class="btn btn-light border btn-legacy" id="btnSave">
                                    Save
                                </button>
                            </div>

                        </div>

                    </div>

                </div>

                <div class="legacy-box mt-2 p-2">

                    <div class="row align-items-center">

                        <div class="col-md-1 text-end fw-bold">
                            Format
                        </div>

                        <div class="col-md-2">
                            <select class="form-select form-select-sm legacy-select" id="PrintFormat">
                                <option>DRS4</option>
                               @*  <option>DRS5</option> *@
                            </select>
                        </div>

                        <div class="col-md-1 fw-bold">
                            DRS No.
                        </div>

                        <div class="col-md-2">
                            <input id="PrintDRSNo" class="form-control form-control-sm legacy-input" />
                        </div>

                        <div class="col-md-6 text-end">

                            <button class="btn btn-light border btn-legacy" id="btnPrintDRS">
                                <i class="bi bi-printer"></i> Print DRS
                            </button>

                            <button class="btn btn-light border btn-legacy" id="btnPrintSummary">
                                <i class="bi bi-printer"></i> Print Summary
                            </button>

                            <button class="btn btn-light border btn-legacy" id="btnPrintDetail">
                                <i class="bi bi-printer"></i> Print Detail
                            </button>

                            <button class="btn btn-light border btn-legacy" id="btnPrintDeliveryRunSheet">
                                <i class="bi bi-printer"></i> Print Delivery Run Sheet
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/DRSEntry.js" asp-append-version="true"></script>