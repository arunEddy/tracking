
@{
    ViewData["Title"] = "CashBooking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CSS & JS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background: #f4f6f9;
    }

    label {
        font-size: 12px;
        font-weight: 600;
    }

    .form-control-sm, .form-select-sm {
        height: 32px;
        font-size: 13px;
    }

    .card {
        border-radius: 10px;
    }

    .modal-content {
        border-radius: 14px;
    }

    .table td, .table th {
        font-size: 13px;
        padding: 6px;
    }
</style>

<div class="container-fluid mt-3">

    <!-- HEADER -->
    <div class="d-flex justify-content-between mb-2">
        <h5 class="fw-bold">Cash Booking</h5>
        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus"></i> Add Booking
        </button>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>AWB</th>
                        <th>Shipper</th>
                        <th>Consignee</th>
                        <th>Total</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="tblData"></tbody>
            </table>
        </div>
    </div>

</div>


<!-- ================= MODAL ================= -->
<div class="modal fade" id="bookingModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h6 id="modalTitle">Cash Booking</h6>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="id">

                <!-- TOP -->
                <div class="row g-2 mb-2">

                    <div class="col-md-3">
                        <label>Booking Office</label>
                        <input id="bookingOffice" class="form-control form-control-sm">
                    </div>

                    <div class="col-md-3">
                        <label>Shipper Name <span style="color:red"> *</span></label>
                        <input id="shipperName" class="form-control form-control-sm">
                    </div>

                    <div class="col-md-2">
                        <label>Docket Type <span style="color:red"> *</span></label>
                        <select id="docketType" class="form-select form-select-sm">
                            <option>--Select--</option>
                            <option value="MANUAL">MANUAL</option>
                            <option value="VIRTUAL">VIRTUAL</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Invoice No</label>
                        <input id="invoiceNumber" class="form-control form-control-sm">
                    </div>

                    <div class="col-md-2">
                        <label>Email</label>
                        <input id="emailId" class="form-control form-control-sm">
                    </div>

                </div>

                <!-- AWB + CONSIGNOR + CONSIGNEE -->
                <div class="row g-2">

                    <!-- AWB -->
                    <div class="col-md-4">
                        <div class="card p-2">
                            <h6 class="text-primary">AWB Details</h6>

                            <input id="awb" placeholder="AWB *" class="form-control form-control-sm mb-1">

                            <input type="date" id="bookingDate" class="form-control form-control-sm mb-1">

                            <input id="origin" placeholder="Origin *" class="form-control form-control-sm mb-1">
                            <input id="destination" placeholder="Destination *" class="form-control form-control-sm mb-1">

                            <input id="mode" placeholder="Mode *" class="form-control form-control-sm mb-1">
                            <input id="product" placeholder="Product *" class="form-control form-control-sm mb-1">

                            <div class="row g-1">
                                <div class="col">
                                    <input id="pcs" placeholder="Pcs *" type="number" class="form-control form-control-sm">
                                </div>
                                <div class="col">
                                    <input id="actualWeight" type="number" placeholder="Actual Wt" class="form-control form-control-sm">
                                </div>
                            </div>

                            <div class="row g-1 mt-1">
                                <div class="col">
                                    <select id="volumetric" class="form-select form-select-sm">
                                        <option value="N">Volumetric N</option>
                                        <option value="Y">Volumetric Y</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <input id="volWeight" placeholder="Vol Wt" type="number" class="form-control form-control-sm">
                                </div>
                            </div>

                            <input id="chargeWeight" placeholder="Charge Wt *" type="number" class="form-control form-control-sm mt-1">

                        </div>
                    </div>

                    <!-- CONSIGNOR -->
                    <div class="col-md-4">
                        <div class="card p-2">
                            <h6 class="text-primary">Consignor</h6>

                            <input id="cMobile" placeholder="Mobile *" class="form-control form-control-sm mb-1">
                            <input id="cGst" placeholder="GST" class="form-control form-control-sm mb-1">
                            <input id="cName" placeholder="Name *" class="form-control form-control-sm mb-1">
                            <input id="cAddress1" placeholder="Address1" class="form-control form-control-sm mb-1">
                            <input id="cAddress2" placeholder="Address2" class="form-control form-control-sm mb-1">
                            <input id="cCity" placeholder="City *" class="form-control form-control-sm mb-1">
                            <input id="cPincode" placeholder="Pincode *" class="form-control form-control-sm mb-1">
                            <input id="cState" placeholder="State" class="form-control form-control-sm">

                        </div>
                    </div>

                    <!-- CONSIGNEE -->
                    <div class="col-md-4">
                        <div class="card p-2">
                            <h6 class="text-primary">Consignee</h6>

                            <input id="cnMobile" placeholder="Mobile *" class="form-control form-control-sm mb-1">
                            <input id="cnGst" placeholder="GST" class="form-control form-control-sm mb-1">
                            <input id="cnName" placeholder="Name *" class="form-control form-control-sm mb-1">
                            <input id="cnAddress1" placeholder="Address1" class="form-control form-control-sm mb-1">
                            <input id="cnAddress2" placeholder="Address2" class="form-control form-control-sm mb-1">
                            <input id="cnCity" placeholder="City *" class="form-control form-control-sm mb-1">
                            <input id="cnPincode" placeholder="Pincode *" class="form-control form-control-sm mb-1">
                            <input id="cnState" placeholder="State" class="form-control form-control-sm">

                            <div class="form-check mt-1">
                                <input type="checkbox" id="oda" class="form-check-input">
                                <label class="form-check-label">ODA Applicable</label>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- REF + REMARK -->
                <div class="row mt-2 g-2">
                    <div class="col-md-6">
                        <input id="referenceNo" placeholder="Reference No" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-6">
                        <input id="remarks" placeholder="Remarks" class="form-control form-control-sm">
                    </div>
                </div>

                <!-- CHARGE + ITEM -->
                <div class="row mt-2">

                    <!-- CHARGES -->
                    <div class="col-md-3">
                        <div class="card p-2">
                            <h6 class="text-primary">Charge Details</h6>

                            <button class="btn btn-secondary btn-sm mb-1" id="btnGetRate">Get Rate</button>

                            <select id="paymentMode" class="form-select form-select-sm mb-1">
                                <option>CASH</option>
                                <option>TOPAY CASH</option>
                            </select>

                            <input id="receivedAmount" placeholder="Received" type="number" class="form-control form-control-sm mb-1">
                            <input id="tariffAmount" placeholder="Tariff" type="number" class="form-control form-control-sm mb-1">
                            <input id="cgst" placeholder="CGST" type="number" class="form-control form-control-sm mb-1">
                            <input id="sgst" placeholder="SGST" type="number" class="form-control form-control-sm mb-1">
                            <input id="igst" placeholder="IGST" type="number" class="form-control form-control-sm mb-1">
                            <input id="total" placeholder="Total" class="form-control form-control-sm">

                        </div>
                    </div>

                    <!-- ITEM -->
                    <div class="col-md-9">

                        <div class="card p-2">
                            <h6 class="text-primary">Item Details</h6>

                            <div class="row g-1 align-items-end">

                                <div class="col">
                                    <input id="invoiceId" placeholder="Invoice ID" class="form-control form-control-sm">
                                </div>

                                <div class="col">
                                    <input type="date" id="invoiceDate" class="form-control form-control-sm">
                                </div>

                                <div class="col-3">
                                    <input id="description" placeholder="Description" class="form-control form-control-sm">
                                </div>

                                <div class="col">
                                    <input id="amount" placeholder="Amount" class="form-control form-control-sm">
                                </div>

                                <div class="col">
                                    <input id="ewayBill" placeholder="EWay Bill" class="form-control form-control-sm">
                                </div>

                                <div class="col">
                                    <input type="date" id="ewbDate" class="form-control form-control-sm">
                                </div>

                                <div class="col-auto">
                                    <button class="btn btn-primary btn-sm" id="btnAddItem">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                            </div>

                            <table class="table table-bordered table-sm mt-2">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Invoice</th>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>EWay</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="itemTable"></tbody>
                            </table>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success btn-sm" id="btnSave">Save</button>
                <button class="btn btn-info btn-sm" id="btnPrint">Print</button>
                <button class="btn btn-warning btn-sm" id="btnSendMail">Send Mail</button>
            </div>

        </div>
    </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<script src="~/js/CashBooking.js" asp-append-version="true"></script>