
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- SweetAlert2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background: #f4f6f9;
    }

    .card {
        border-radius: 12px;
    }

    .modal-content {
        border-radius: 14px;
    }

    .btn {
        border-radius: 8px;
    }

    .table-hover tbody tr:hover {
        background: #eef3ff;
    }
</style>
<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold">Stock Return</h4>
            <small class="text-muted">Manage stock return entries</small>
        </div>
        <button class="btn btn-danger" id="btnAdd">
            <i class="bi bi-plus-lg"></i> Add Return
        </button>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>From Office</th>
                        <th>To Office</th>
                        <th>Shipper Name</th>
                        <th>Return Date</th>
                        <th>
                            Item Name
                        </th>
                        <th>Quantity </th>
                        <th>Start No</th>
                        <th>End No</th>
                        <th>Bal. Quantity</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="tblData"></tbody>
            </table>

        </div>
    </div>
</div>


<!-- MODAL -->
<div class="modal fade" id="stockReturnModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">

            <div class="modal-header bg-danger text-white">
                <h5 id="modalTitle">Add Stock Return</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="srid">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label>From Office <span style="color:red"> *</span></label>
                        <input type="text" id="fromOffice" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>To Office <span style="color:red"> *</span></label>
                        <input type="text" id="toOffice" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Shipper Name</label>
                        <input type="text" id="shipperName" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Return Date <span style="color:red"> *</span></label>
                        <input type="date" id="returnDate" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Item Name <span style="color:red"> *</span></label>
                        <input type="text" id="itemName" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Quantity <span style="color:red"> *</span></label>
                        <input type="number" id="quantity" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Start No</label>
                        <input type="number" id="startNo" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>End No</label>
                        <input type="number" id="endNo" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Balance Qty</label>
                        <input type="number" id="balQty" class="form-control" readonly>
                    </div>
                    <div class="col-md-3">
                        <label>Status  </label>
                        <select id="isActive" class="form-select">
                            <option value="Yes">
                                Yes
                            </option>
                            <option value="No">
                                No
                            </option>
                        </select>
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSave">💾 Save</button>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<script src="~/js/StockReturn.js" asp-append-version="true"></script>