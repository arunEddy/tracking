
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. jQuery FIRST -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2. Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- 3. SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h4>Stock Payment Voucher</h4>
        <button class="btn btn-primary" id="btnAdd">+ Add Voucher</button>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Sno.</th>
                <th>Voucher Number</th>
                <th>Franchise Name</th>
                <th>Payment Date</th>
                <th>Quantity </th>
                <th>Amount Per AWB</th>
                <th>Total Amount</th>
                <th>Payment Mode</th>
                <th>Bank Name</th>
                <th>Cheque/DD No</th>
                <th>Remarks</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="tblData"></tbody>
    </table>
</div>

<!-- MODAL -->
<div class="modal fade" id="voucherModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="modalTitle">Add Voucher</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="spvId">

                <div class="row g-3">
                    <div class="col-md-4">
                        <label>Voucher Number <span style="color:red"></span></label>
                        <input type="text" id="voucherNo" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label>Franchise Name <span style="color:red"> <span style="color:red"> *</span></span></label>
                        <input type="text" id="franchise" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label>Payment Date <span style="color:red"> <span style="color:red"> *</span></span></label>
                        <input type="date" id="paymentDate" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label>Quantity <span style="color:red"> *</span></label>
                        <input type="number" id="qty" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label>Amount Per AWB <span style="color:red"> *</span></label>
                        <input type="number" id="rate" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label>Total Amount</label>
                        <input type="number" id="total" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label>Payment Mode <span style="color:red"> *</span></label>
                        <select id="paymentMode" class="form-control">
                            <option value="">Select</option>
                            <option selected="selected" value="-1">----Select----</option>
                            <option value="ADJUSTED IN ACCOUNT">ADJUSTED IN ACCOUNT</option>
                            <option value="CASH DEPOSITED IN FDC BANK A/C">CASH DEPOSITED IN FDC BANK A/C</option>
                            <option value="CASH SENT TO FDC OFFICE">CASH SENT TO FDC OFFICE</option>
                            <option value="CHEQUE TO FDC">CHEQUE TO FDC</option>
                            <option value="CHEQUE TO SHIPPER">CHEQUE TO SHIPPER</option>
                            <option value="COD FREE">COD FREE</option>
                            <option value="DRAFT IN NAME OF FDC">DRAFT IN NAME OF FDC</option>
                            <option value="DRAFT IN NAME OF SHIPPER">DRAFT IN NAME OF SHIPPER</option>
                            <option value="NEFT BY FDC">NEFT BY FDC</option>
                            <option value="NEFT TO SHIPPER">NEFT TO SHIPPER</option>
                            <option value="TDS DEDUCT BY CUSTOMER">TDS DEDUCT BY CUSTOMER</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Bank Name</label>
                        <input type="text" id="bankname" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label>Cheque/DD No</label>
                        <input type="text" id="cheque" class="form-control">
                    </div>

                    <div class="col-md-12">
                        <label>Remarks</label>
                        <textarea id="remarks" class="form-control"></textarea>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSave">💾 Save</button>
             
            </div>

        </div>
    </div>
</div>

<div id="loader" style="display:none">Loading...</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/StockPaymentVoucher.js" asp-append-version="true"></script>