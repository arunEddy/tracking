
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<style>

    body {
        background: #f4f6f9;
        font-size: 12px;
    }

    .card-box {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 6px;
        padding: 10px;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
    }

    .top-header {
        background: #b81414;
        color: #fff;
        padding: 8px;
        font-weight: 700;
        border-radius: 4px 4px 0 0;
        font-size: 14px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 2px;
        font-size: 12px;
    }

    .form-control-sm,
    .form-select-sm {
        height: 28px;
        font-size: 12px;
    }

    .required {
        color: red;
    }

    .table thead {
        background: #b81414;
        color: white;
        font-size: 12px;
    }

    .table tbody tr:hover {
        background: #f1f7ff;
    }

    .action-btn {
        border: none;
        background: transparent;
        font-size: 15px;
    }

    .modal-xl {
        max-width: 95%;
    }

    .section-title {
        background: #b81414;
        color: #fff;
        padding: 6px 10px;
        font-weight: 700;
        border-radius: 4px 4px 0 0;
        font-size: 13px;
    }

    .section-body {
        border: 1px solid #d7d7d7;
        border-top: 0;
        padding: 10px;
        background: #fff;
    }

    #loader {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.7);
        z-index: 99999;
        display: none;
    }

        #loader div {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
        }

</style>

<div id="loader">
    <div class="spinner-border text-danger"></div>
</div>

<div class="container-fluid mt-2">

    <div class="card-box">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-truck"></i>
                NON DELIVERY ENTRY
            </h5>

            <button class="btn btn-danger btn-sm" id="btnAdd">
                <i class="bi bi-plus-circle"></i>
                Add New
            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover table-sm align-middle">

                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th>Destination Office</th>
                        <th>AWB No</th>
                        <th>NDR Date</th>
                        <th>NDR Reason</th>
                        <th>Remarks</th>
                        <th>Shipper Name</th>
                        <th>Total NDR</th>
                        <th>Physical Attempt</th>
                        <th>Max Attempt</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>

                <tbody id="tblData"></tbody>

            </table>

        </div>

    </div>

</div>

<div class="modal fade" id="ndrModal" tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-danger text-white py-2">

                <h6 class="modal-title fw-bold">
                    NON DELIVERY ENTRY
                </h6>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body bg-light">

                <input type="hidden" id="ndId">

                <div class="section-title">
                    FIELDS WITH <span class="required">*</span> MARK ARE MANDATORY
                </div>

                <div class="section-body">

                    <div class="row g-2">

                        <div class="col-md-4">

                            <label class="form-label">
                                Destination Office
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   id="DestinationOffice"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                AWB No
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   id="AwbNo"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                NDR Date
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   id="NDRDate"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-4">

                            <label class="form-label">
                                NDR Reason
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   id="NDRReason"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Remarks
                            </label>

                            <input type="text"
                                   id="Remarks"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Shipper Name
                            </label>

                            <input type="text"
                                   id="ShipperName"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-1">

                            <label class="form-label">
                                Total NDR
                            </label>

                            <input type="number"
                                   id="TotalNDR"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-1">

                            <label class="form-label">
                                Physical Attempt
                            </label>

                            <input type="number"
                                   id="PhysicalAttempt"
                                   class="form-control form-control-sm">

                        </div>

                        <div class="col-md-1">

                            <label class="form-label">
                                Max Attempt
                            </label>

                            <input type="number"
                                   id="MaxAttempt"
                                   class="form-control form-control-sm">

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer bg-white py-2">

                <button class="btn btn-secondary btn-sm px-4"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle"></i>
                    Cancel

                </button>

                <button class="btn btn-success btn-sm px-4"
                        id="btnSave">

                    <i class="bi bi-check-circle"></i>
                    Save

                </button>

            </div>

        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="~/js/NonDelivery.js"></script>