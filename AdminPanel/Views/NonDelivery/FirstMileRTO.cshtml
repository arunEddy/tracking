
@{
    ViewData["Title"] = "FirstMileRTO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

    body {
        font-size: 12px;
        background: #efefef;
    }

    .legacy-wrapper {
        border: 1px solid #8f8f8f;
        background: #f5f5f5;
    }

    .legacy-header {
        background: #b71c1c;
        color: #fff;
        font-weight: bold;
        text-align: center;
        padding: 6px;
        font-size: 20px;
        letter-spacing: 1px;
    }

    .legacy-subheader {
        background: #b71c1c;
        color: white;
        padding: 4px 8px;
        font-weight: bold;
    }

    .form-control-sm {
        height: 24px;
        border-radius: 0px;
        font-size: 12px;
        border: 1px solid #1e88e5;
    }

    .btn-legacy {
        border-radius: 0px;
        font-size: 12px;
        padding: 2px 20px;
        font-weight: 600;
    }

    .table td,
    .table th {
        vertical-align: middle;
        font-size: 12px;
    }

    .mandatory {
        color: red;
    }

</style>

<div class="container-fluid mt-3">

    <div class="d-flex justify-content-between align-items-center mb-2">

        <h5 class="fw-bold">
            FIRST MILE RTO
        </h5>

        <button class="btn btn-primary btn-sm"
                id="btnAdd">

            <i class="bi bi-plus-circle"></i>
            Add New

        </button>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover table-sm bg-white">

            <thead class="table-dark">

                <tr>

                    <th>SL#</th>
                   
                    <th>AWB Number</th>
                    <th>RTO Date</th>
                    <th>RTO Reason</th>
                    <th width="120">Action</th>

                </tr>

            </thead>

            <tbody id="tblData"></tbody>

        </table>

    </div>

</div>

<!-- MODAL -->

<div class="modal fade"
     id="rtoModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="legacy-header">
                FIRST MILE RTO
            </div>

            <div class="modal-body p-0">

                <input type="hidden" id="rtoid" />

                <div class="legacy-wrapper">

                    <div class="legacy-subheader">

                        FIELDS WITH
                        <span class="mandatory">*</span>
                        MARK ARE MANDATORY.

                    </div>

                    <div class="legacy-subheader mt-1">

                        <div class="row">

                            <div class="col-md-2">
                                Awb No
                                <span class="mandatory">*</span>
                            </div>

                            <div class="col-md-2">
                                RTO Date
                                <span class="mandatory">*</span>
                            </div>

                            <div class="col-md-4">
                                RTO Reason
                                <span class="mandatory">*</span>
                            </div>

                            <div class="col-md-4"></div>

                        </div>

                    </div>

                    <div class="p-2">

                        <div class="row align-items-end">

                            <div class="col-md-2">

                                <input type="text"
                                       id="AWBNumber"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-2">

                                <input type="date"
                                       id="RTODate"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-4">

                                <input type="text"
                                       id="RTOReason"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-4">

                                <button class="btn btn-success btn-sm btn-legacy"
                                        id="btnSave">

                                    <i class="bi bi-save"></i>
                                    Save

                                </button>

                                <button class="btn btn-secondary btn-sm btn-legacy"
                                        data-bs-dismiss="modal">

                                    Cancel

                                </button>

                            </div>

                        </div>

                    </div>

                 

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/FirstMileRTO.js"></script>
