
@{
    ViewData["Title"] = "ReturnToCustomerManifesting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

    body {
        font-size: 12px;
    }

    .legacy-box {
        border: 1px solid #9e9e9e;
        background: #f4f4f4;
    }

    .legacy-header {
        background: #b71c1c;
        color: white;
        padding: 6px;
        font-weight: bold;
        text-align: center;
        letter-spacing: .5px;
    }

    .legacy-subheader {
        background: #b71c1c;
        color: white;
        padding: 4px;
        font-weight: bold;
    }

    .form-control-sm {
        border-radius: 0px;
        height: 24px;
        font-size: 12px;
    }

    .btn-legacy {
        border-radius: 0px;
        padding: 2px 15px;
        font-size: 12px;
        font-weight: 600;
    }

    .table td, .table th {
        vertical-align: middle;
        font-size: 12px;
    }

    .mandatory {
        color: red;
    }

</style>

<div class="container-fluid mt-2">

    <div class="d-flex justify-content-between mb-2">

        <h6 class="fw-bold">
            RETURN TO CUSTOMER MANIFESTING
        </h6>

        <button class="btn btn-primary btn-sm"
                id="btnAdd">
            <i class="bi bi-plus-circle"></i> Add New
        </button>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover table-sm">

            <thead class="table-dark">

                <tr>
                    <th>#</th>
                    <th>Shipper Name</th>
                    <th>Delivery Boy</th>
                    <th>Return Date</th>
                    <th>Bag Number</th>
                    <th>Remarks</th>
                    <th>AWB Number</th>
                    <th>Reason</th>
                    <th width="120">Action</th>
                </tr>

            </thead>

            <tbody id="tblData"></tbody>

        </table>

    </div>

</div>

<!-- MODAL -->

<div class="modal fade"
     id="manifestModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="legacy-header">
                RETURN TO CUSTOMER MANIFESTING
            </div>

            <div class="modal-body p-2">

                <input type="hidden" id="rtcmid" />

                <div class="legacy-box">

                    <div class="p-2">

                        <div class="row">

                            <div class="col-md-4">

                                <label class="fw-bold">
                                    Shipper Name
                                    <span class="mandatory">*</span>
                                </label>

                                <input type="text"
                                       id="ShipperName"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-4">

                                <label class="fw-bold">
                                    Delivery Boy
                                    <span class="mandatory">*</span>
                                </label>

                                <input type="text"
                                       id="DeliveryBoy"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-4">

                                <label class="fw-bold">
                                    Return Date
                                    <span class="mandatory">*</span>
                                </label>

                                <input type="date"
                                       id="ReturnDate"
                                       class="form-control form-control-sm" />

                            </div>

                        </div>

                        <div class="row mt-2">

                            <div class="col-md-4">

                                <label class="fw-bold">
                                    Bag Number
                                </label>

                                <input type="text"
                                       id="BagNumber"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-8">

                                <label class="fw-bold">
                                    Remarks
                                </label>

                                <input type="text"
                                       id="Remarks"
                                       class="form-control form-control-sm" />

                            </div>

                        </div>

                    </div>

                    <div class="legacy-subheader">

                        <div class="row">

                            <div class="col-md-3">
                                AWB Number
                                <span class="mandatory">*</span>
                            </div>

                            <div class="col-md-5">
                                Reason
                                <span class="mandatory">*</span>
                            </div>

                            <div class="col-md-4"></div>

                        </div>

                    </div>

                    <div class="p-2">

                        <div class="row align-items-end">

                            <div class="col-md-3">

                                <input type="text"
                                       id="AWBNumber"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-5">

                                <input type="text"
                                       id="Reason"
                                       class="form-control form-control-sm" />

                            </div>

                            <div class="col-md-4">

                                <button class="btn btn-success btn-sm btn-legacy"
                                        id="btnSave">
                                    <i class="bi bi-save"></i>
                                    Save
                                </button>

                                <button class="btn btn-secondary btn-sm btn-legacy"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                            </div>

                        </div>

                    </div>

                    <div class="border-top p-2">

                        <div class="text-end">

                            <label class="fw-bold">
                                Manifest No.
                            </label>

                            <input type="text"
                                   id="ManifestNo"
                                   class="form-control form-control-sm d-inline-block"
                                   style="width:150px;" />

                            <button class="btn btn-dark btn-sm btn-legacy"
                                    id="btnPrintLaser">
                                <i class="bi bi-printer"></i>
                                Print Manifest(Laser)
                            </button>

                            <button class="btn btn-primary btn-sm btn-legacy"
                                    id="btnPrint">
                                <i class="bi bi-printer-fill"></i>
                                Print Manifest
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/ReturnToCustomerManifesting.js"></script>